# Backend (server/index.js) — copy to .env for local use. Never commit .env.
# JWT_SECRET: required in production. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The value below is a placeholder, NOT a real secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Backend port (frontend Vite proxies /api to this port)
PORT=3011
# Postgres connection (phase 2+). The server reads DATABASE_URL only.
# Local dev example:  postgresql://postgres:postgres@localhost:5432/sla
# Supabase example:   postgresql://postgres:<redacted>
#   (get it from Supabase dashboard -> Project Settings -> Database ->
#   Connection string -> URI; keep the [YOUR-PASSWORD] replaced).
# Never commit a real connection string. .env is git-ignored.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sla
# Local demo accounts only (seed users, first DB creation only).
# Default demo password is documented in README.md; change it for any shared
# environment. This is not used for real user accounts.
DEMO_PASSWORD=DemoPass123
# Demo seeding: never runs when NODE_ENV=production unless SEED_DEMO=true.
# Local dev (NODE_ENV unset) keeps the old behavior: seed into an empty DB.
# SEED_DEMO=false

# Production email via Resend (https://resend.com). REQUIRED in production:
# verification and password-reset codes are emailed; without these two vars
# the server refuses to start when NODE_ENV=production. The sending domain
# must be verified in Resend (DNS records). The API key never goes in chat.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@landlordassistant.us

# Production frontend build: point the app at the public API.
# VITE_API_URL=https://sla-api-indr.onrender.com

# Legacy AI Studio placeholders (not used by the local backend in phase 1)
# GEMINI_API_KEY is not read by server/ or src/ in phase 1; the metadata
# claim about server-side Gemini is therefore not relied on.
GEMINI_API_KEY=
APP_URL="MY_APP_URL"
